# Research Continuity Agent — environment configuration
# Copy to .env and edit as needed:
#   cp .env.example .env
#
# All variables are optional; defaults are shown here.
# Ollama must be running locally before starting the app when
# `RCA_LLM_BACKEND=ollama` (the default).

# ── General ──────────────────────────────────────────────────────────────────

RCA_ENVIRONMENT=development

# Root directory exposed to the filesystem MCP server (defaults to cwd)
# RCA_WORKSPACE_ROOT=/path/to/your/workspace

# ── Storage ──────────────────────────────────────────────────────────────────

RCA_DATA_DIR=.rca
RCA_GRAPH_DB_PATH=.rca/graph.sqlite3
RCA_VECTOR_DIR=.rca/vectors
RCA_EVENT_LOG_PATH=.rca/events.jsonl
RCA_TELEMETRY_LOG_PATH=.rca/telemetry.jsonl
RCA_EXPERIMENT_DB_PATH=.rca/experiments.sqlite3
RCA_DEFAULT_COLLECTION=research-continuity

# ── Ingest ───────────────────────────────────────────────────────────────────

RCA_CHUNK_SIZE=1200
RCA_CHUNK_OVERLAP=150

# ── Backend selection ─────────────────────────────────────────────────────────

RCA_LLM_BACKEND=ollama

# ── Ollama models ─────────────────────────────────────────────────────────────
# Pull both models before first use:
#   ollama pull nomic-embed-text
#   ollama pull qwen2.5:14b

RCA_EMBEDDING_BASE_URL=http://localhost:11434
RCA_EMBEDDING_MODEL=nomic-embed-text
RCA_LLM_BASE_URL=http://localhost:11434
RCA_LLM_API_KEY=ollama
RCA_GENERATION_MODEL=qwen2.5:14b

# ── OpenAI-compatible backend (optional) ─────────────────────────────────────
# Used when `RCA_LLM_BACKEND=openai_compatible`.
# Override the base URL for OpenAI, Groq, Together, local vLLM, etc.

RCA_OPENAI_BASE_URL=https://api.openai.com/v1
RCA_OPENAI_API_KEY=
RCA_OPENAI_CHAT_MODEL=gpt-4o-mini
RCA_OPENAI_EMBED_MODEL=text-embedding-3-small

RCA_ENABLE_RERANKER=true
RCA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RCA_RERANKER_TOP_K=10
RCA_RETRIEVAL_FETCH_LIMIT=20

# ── Misc ─────────────────────────────────────────────────────────────────────

RCA_TOOL_POLICY_PATH=rca/config/tool_policies.yaml

# Disable ChromaDB anonymous telemetry
ANONYMIZED_TELEMETRY=False
