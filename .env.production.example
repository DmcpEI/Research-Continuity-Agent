# Research Continuity Agent — production-ish demo configuration
# This file is for container / ECS demos, not local Ollama development.

RCA_ENVIRONMENT=production
RCA_LLM_BACKEND=openai_compatible

# Scope filesystem tools tightly or disable them entirely in cloud demos.
RCA_ENABLE_FILESYSTEM_TOOLS=false
RCA_WORKSPACE_ROOT=/app
RCA_FILESYSTEM_ROOT=/app

RCA_DATA_DIR=/app/.rca
RCA_GRAPH_DB_PATH=/app/.rca/graph.sqlite3
RCA_VECTOR_DIR=/app/.rca/vectors
RCA_EXPERIMENT_DB_PATH=/app/.rca/experiments.sqlite3

RCA_OPENAI_BASE_URL=https://api.openai.com/v1
RCA_OPENAI_API_KEY=
RCA_OPENAI_CHAT_MODEL=gpt-4o-mini
RCA_OPENAI_EMBED_MODEL=text-embedding-3-small

RCA_ENABLE_RERANKER=true
RCA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RCA_RERANKER_TOP_K=10
RCA_RETRIEVAL_FETCH_LIMIT=20

ANONYMIZED_TELEMETRY=False
